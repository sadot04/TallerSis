{
  "openapi": "3.1.0",
  "info": {
    "title": "Observatorio Vial",
    "version": "1.0.0",
    "description": "Clasificación de gravedad de accidentes reportados. Obtén un token con /api/auth/login y úsalo con Authorize."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Servicio"
    },
    {
      "name": "Sesión"
    },
    {
      "name": "Predicciones"
    },
    {
      "name": "Modelo"
    },
    {
      "name": "Datos"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Servicio"
        ],
        "summary": "Consultar estado",
        "security": [],
        "responses": {
          "200": {
            "description": "Disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Sesión"
        ],
        "summary": "Obtener token JWT",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT emitido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "expiresIn",
                    "username"
                  ],
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "username": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model/features": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Consultar campos y opciones",
        "responses": {
          "200": {
            "description": "Campos del modelo activo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Feature"
                  }
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model/metrics": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Consultar versión y métricas",
        "responses": {
          "200": {
            "description": "Evaluación de referencia",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Metrics"
                    },
                    {
                      "type": "object",
                      "required": [
                        "version",
                        "createdAt"
                      ],
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model/export": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Descargar el pipeline activo",
        "responses": {
          "200": {
            "description": "Archivo Joblib del modelo activo y sus factores de decisión, cuando correspondan.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/predictions": {
      "post": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Clasificar y guardar un reporte",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Predicción guardada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Proceso de ML no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Tiempo de ML agotado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Consultar historial",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "before",
            "description": "Usa nextBefore de la página anterior.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de predicciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextBefore"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Prediction"
                      }
                    },
                    "nextBefore": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets": {
      "get": {
        "tags": [
          "Datos"
        ],
        "summary": "Listar archivos validados",
        "responses": {
          "200": {
            "description": "Hasta 50 cargas recientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Dataset"
                  }
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Datos"
        ],
        "summary": "Cargar CSV etiquetado",
        "description": "Incluye las 13 columnas contractuales y Accident_severity. Máximo de 8 MiB y 100 000 filas. Se requieren 150 filas distintas y 15 por clase.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CSV validado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dataset"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Solicitud demasiado grande",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Proceso de ML no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Tiempo de ML agotado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model/retrain": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Solicitar reentrenamiento",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "datasetId"
                ],
                "properties": {
                  "datasetId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Trabajo aceptado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Entrenamiento ocupado o falta el CSV original",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/model/retrain/{id}": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Consultar estado del reentrenamiento",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trabajo de entrenamiento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "JWT inválido o ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origen no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Input": {
        "type": "object",
        "required": [
          "Time",
          "Day_of_week",
          "Driving_experience",
          "Type_of_vehicle",
          "Area_accident_occured",
          "Road_surface_type",
          "Road_surface_conditions",
          "Light_conditions",
          "Weather_conditions",
          "Types_of_Junction",
          "Type_of_collision",
          "Number_of_vehicles_involved",
          "Number_of_casualties"
        ],
        "properties": {
          "Time": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
            "example": "17:02"
          },
          "Day_of_week": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Monday"
          },
          "Driving_experience": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "2-5yr"
          },
          "Type_of_vehicle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Automobile"
          },
          "Area_accident_occured": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Residential areas"
          },
          "Road_surface_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Asphalt roads"
          },
          "Road_surface_conditions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Dry"
          },
          "Light_conditions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Daylight"
          },
          "Weather_conditions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Normal"
          },
          "Types_of_Junction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "No junction"
          },
          "Type_of_collision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Vehicle with vehicle collision"
          },
          "Number_of_vehicles_involved": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "example": 2
          },
          "Number_of_casualties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "example": 1
          }
        },
        "additionalProperties": false
      },
      "Prediction": {
        "type": "object",
        "required": [
          "id",
          "input",
          "category",
          "probabilities",
          "version",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "category": {
            "type": "string",
            "enum": [
              "Slight Injury",
              "Serious Injury",
              "Fatal injury"
            ]
          },
          "probabilities": {
            "type": "object",
            "description": "Puntajes normalizados de las clases. Pueden incorporar factores de decisión y no son probabilidades calibradas.",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "version": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Dataset": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "rows",
          "classes",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 1
          },
          "classes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Metrics": {
        "type": "object",
        "required": [
          "algorithm",
          "accuracy",
          "balancedAccuracy",
          "macroF1",
          "baselineMacroF1",
          "labels",
          "perClass",
          "confusionMatrix",
          "validationMacroF1",
          "trainRows",
          "testRows",
          "testClassCounts",
          "sourceSha256",
          "referenceSha256",
          "sklearnVersion",
          "seed"
        ],
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "accuracy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "balancedAccuracy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "macroF1": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "baselineMacroF1": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Slight Injury",
                "Serious Injury",
                "Fatal injury"
              ]
            }
          },
          "perClass": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "precision",
                "recall",
                "f1-score",
                "support"
              ],
              "properties": {
                "precision": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "recall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "f1-score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "support": {
